# ---------------------------------------------------------------------------
# Copy this file to .env and fill in the values for your lab VM.
# .env is git-ignored. Never commit real credentials, and never paste them into
# a screenshot or log attached as evidence (Playwright Lab Manual, section 21).
# ---------------------------------------------------------------------------

# --- Application under test -------------------------------------------------
# REQUIRED. Port 8081 is the insurance application; 8082 is FinServe (out of scope).
# The VM's public IP changes when the lab is restarted - check it in TalentFarm.
#   Inside the VM:  http://127.0.0.1:8081
#   From outside:   http://<vm-public-ip>:8081
BASE_URL=http://127.0.0.1:8081

# Optional. Defaults to ${BASE_URL}/api.
API_BASE_URL=http://127.0.0.1:8081/api

# --- Primary agent (REQUIRED) -----------------------------------------------
AGENT_USERNAME=agent.valid@insurance.test
AGENT_PASSWORD=replace-me

# --- Second agent -----------------------------------------------------------
# Mandatory for data isolation tests (R-DASH-01, R-DOC-05, TC-DASH-002,
# TC-API-008). Those tests skip themselves if this is blank.
SECOND_AGENT_USERNAME=
SECOND_AGENT_PASSWORD=

# --- Locked agent -----------------------------------------------------------
# For TC-AUTH-006. See Q-09: without a documented unlock route this account is
# effectively single-use per cohort.
LOCKED_AGENT_USERNAME=
LOCKED_AGENT_PASSWORD=

# --- New / empty agent ------------------------------------------------------
# For the empty dashboard state, TC-DASH-003.
NEW_AGENT_USERNAME=
NEW_AGENT_PASSWORD=

# --- MFA / OTP --------------------------------------------------------------
# A fixed test OTP if the lab simulates MFA (Q-10). Leave blank if not used.
TEST_OTP=

# --- Database (read-only) ---------------------------------------------------
# Backend verification per section 8.4 of the Study and QA Plan. Requested as
# Q-04. Leave DB_ENABLED=false until read-only credentials are granted; the
# database-dependent tests skip themselves rather than fail.
DB_ENABLED=false
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# --- Business rule values ---------------------------------------------------
# Defaults follow assumption A-04 from Submission 1. Confirm inclusivity via Q-08.
RULE_MIN_AGE=18
RULE_MAX_AGE=65
RULE_AGE_BOUNDS_INCLUSIVE=true
RULE_MAX_UPLOAD_MB=5
RULE_MAX_RIDERS=3

# --- Seeded defect profile --------------------------------------------------
# If the lab exposes a defect switch profile, record it here so a run can be
# correlated with the defect state it was executed against (Q-07).
DEFECT_PROFILE=unknown
